diff --git a/src/components/shared/LineChart.tsx b/src/components/shared/LineChart.tsx
new file mode 100644
index 0000000..3d4e7c0
--- /dev/null
+++ b/src/components/shared/LineChart.tsx
@@ -0,0 +1,211 @@
+import * as React from 'react';
+
+import { withAlpha } from '~/modules/home/utils';
+
+const { useEffect, useRef, useState } = React;
+
+// podkop-exp build: the area charts drawn on a canvas, in place of chart.js. They are drawn
+// when their data changes, not at every frame.
+
+export type Series = { label: string; color: string; values: (number | null)[] };
+
+type Props = {
+  series: Series[];
+  // times of the points (ms), for the tooltip
+  labels?: number[];
+  range: { min: number; max: number };
+  // horizontal lines across the chart
+  grid?: number;
+  // the text of a value in the tooltip; none: no tooltip
+  format?: (value: number) => string;
+};
+
+const GRID_COLOR = 'rgba(148, 163, 184, 0.22)';
+
+// a curve through every point of a run that rises and falls only where the points do
+// (monotone cubic): no overshoot, no dip below zero
+function smooth(points: [number, number][]): Path2D {
+  const path = new Path2D();
+  const count = points.length;
+  path.moveTo(points[0][0], points[0][1]);
+  if (count < 3) {
+    for (let i = 1; i < count; i++) path.lineTo(points[i][0], points[i][1]);
+    return path;
+  }
+  const secant = (i: number) =>
+    (points[i + 1][1] - points[i][1]) / (points[i + 1][0] - points[i][0]);
+  const tangent = (i: number) => {
+    if (i === 0) return secant(0);
+    if (i === count - 1) return secant(count - 2);
+    const before = secant(i - 1);
+    const after = secant(i);
+    return before * after <= 0 ? 0 : 2 / (1 / before + 1 / after);
+  };
+  let previous = tangent(0);
+  for (let i = 0; i < count - 1; i++) {
+    const [x0, y0] = points[i];
+    const [x1, y1] = points[i + 1];
+    const next = tangent(i + 1);
+    const third = (x1 - x0) / 3;
+    path.bezierCurveTo(x0 + third, y0 + previous * third, x1 - third, y1 - next * third, x1, y1);
+    previous = next;
+  }
+  return path;
+}
+
+export default function LineChart({ series, labels, range, grid = 0, format }: Props) {
+  const wrap = useRef<HTMLDivElement>(null);
+  const canvas = useRef<HTMLCanvasElement>(null);
+  const [size, setSize] = useState({ width: 0, height: 0 });
+  const [hover, setHover] = useState<number | null>(null);
+  const count = Math.max(0, ...series.map((one) => one.values.length));
+
+  useEffect(() => {
+    const element = wrap.current;
+    if (!element) return;
+    const measure = () => setSize({ width: element.clientWidth, height: element.clientHeight });
+    measure();
+    if (typeof ResizeObserver === 'undefined') return;
+    const observer = new ResizeObserver(measure);
+    observer.observe(element);
+    return () => observer.disconnect();
+  }, []);
+
+  useEffect(() => {
+    const element = canvas.current;
+    const { width, height } = size;
+    if (!element || width === 0 || height === 0) return;
+    const ratio = window.devicePixelRatio || 1;
+    element.width = Math.round(width * ratio);
+    element.height = Math.round(height * ratio);
+    const context = element.getContext('2d');
+    if (!context) return;
+    context.setTransform(ratio, 0, 0, ratio, 0, 0);
+    context.clearRect(0, 0, width, height);
+    const top = 2;
+    const span = range.max - range.min || 1;
+    const x = (index: number) => (count > 1 ? (index / (count - 1)) * width : width / 2);
+    const y = (value: number) => top + (1 - (value - range.min) / span) * (height - top);
+
+    if (grid > 1) {
+      context.strokeStyle = GRID_COLOR;
+      context.lineWidth = 1;
+      for (let line = 0; line < grid; line++) {
+        const at = Math.round(top + (line / (grid - 1)) * (height - top - 1)) + 0.5;
+        context.beginPath();
+        context.moveTo(0, at);
+        context.lineTo(width, at);
+        context.stroke();
+      }
+    }
+
+    for (const one of series) {
+      // the runs of points without a gap, each drawn smooth through its points
+      const runs: [number, number][][] = [];
+      let run: [number, number][] = [];
+      one.values.forEach((value, index) => {
+        if (value === null || value === undefined || Number.isNaN(value)) {
+          if (run.length) runs.push(run);
+          run = [];
+        } else {
+          run.push([x(index), y(Math.min(Math.max(value, range.min), range.max))]);
+        }
+      });
+      if (run.length) runs.push(run);
+      const fill = context.createLinearGradient(0, top, 0, height);
+      fill.addColorStop(0, withAlpha(one.color, 0.35));
+      fill.addColorStop(1, withAlpha(one.color, 0.02));
+      for (const points of runs) {
+        const path = smooth(points);
+        const area = new Path2D(path);
+        area.lineTo(points[points.length - 1][0], height);
+        area.lineTo(points[0][0], height);
+        area.closePath();
+        context.fillStyle = fill;
+        context.fill(area);
+        context.strokeStyle = one.color;
+        context.lineWidth = 2;
+        context.lineJoin = 'round';
+        context.stroke(path);
+      }
+    }
+
+    if (hover !== null && hover < count) {
+      context.strokeStyle = GRID_COLOR;
+      context.lineWidth = 1;
+      context.beginPath();
+      context.moveTo(Math.round(x(hover)) + 0.5, top);
+      context.lineTo(Math.round(x(hover)) + 0.5, height);
+      context.stroke();
+      for (const one of series) {
+        const value = one.values[hover];
+        if (value === null || value === undefined) continue;
+        context.fillStyle = one.color;
+        context.beginPath();
+        context.arc(
+          x(hover),
+          y(Math.min(Math.max(value, range.min), range.max)),
+          3,
+          0,
+          Math.PI * 2,
+        );
+        context.fill();
+      }
+    }
+  }, [series, range.min, range.max, grid, size, hover, count]);
+
+  const onMove = format
+    ? (event: React.MouseEvent<HTMLDivElement>) => {
+        const box = event.currentTarget.getBoundingClientRect();
+        if (count < 1 || box.width === 0) return;
+        const at = Math.round(((event.clientX - box.left) / box.width) * (count - 1));
+        setHover(Math.min(Math.max(at, 0), count - 1));
+      }
+    : undefined;
+
+  let tip: React.ReactNode = null;
+  if (format && hover !== null && hover < count) {
+    const time = labels && labels[hover] ? new Date(labels[hover]).toLocaleTimeString() : '';
+    const left = count > 1 ? (hover / (count - 1)) * 100 : 50;
+    tip = (
+      <div
+        style={{
+          position: 'absolute',
+          top: 4,
+          left: left > 60 ? undefined : `calc(${left}% + 8px)`,
+          right: left > 60 ? `calc(${100 - left}% + 8px)` : undefined,
+          padding: '4px 8px',
+          borderRadius: 6,
+          background: 'rgba(0, 0, 0, 0.7)',
+          color: '#fff',
+          fontSize: 12,
+          whiteSpace: 'nowrap',
+          pointerEvents: 'none',
+        }}
+      >
+        {time ? <div>{time}</div> : null}
+        {series.map((one) => {
+          const value = one.values[hover];
+          if (value === null || value === undefined) return null;
+          return (
+            <div key={one.label}>
+              <span style={{ color: one.color }}>●</span> {one.label} {format(value)}
+            </div>
+          );
+        })}
+      </div>
+    );
+  }
+
+  return (
+    <div
+      ref={wrap}
+      style={{ position: 'relative', width: '100%', height: '100%' }}
+      onMouseMove={onMove}
+      onMouseLeave={format ? () => setHover(null) : undefined}
+    >
+      <canvas ref={canvas} style={{ display: 'block', width: '100%', height: '100%' }} />
+      {tip}
+    </div>
+  );
+}
