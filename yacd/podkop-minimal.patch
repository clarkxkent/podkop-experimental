@@ -0,0 +1,27 @@
+// A stand-in for i18next and react-i18next (podkop-exp build): the dashboard is English only,
+// and uses t() with {{name}} interpolation and the language.
+import { data as english } from '~/i18n/en';
+
+type Options = Record<string, unknown>;
+
+function t(key: string, options?: Options): string {
+  const text = (english as Record<string, string>)[key] ?? key;
+  if (!options) return text;
+  return text.replace(/\{\{\s*(\w+)\s*\}\}/g, (whole, name) =>
+    name in options ? String(options[name]) : whole,
+  );
+}
+
+const i18n = {
+  language: 'en',
+  t,
+  changeLanguage: () => Promise.resolve(t),
+};
+
+export function useTranslation() {
+  return { t, i18n };
+}
+
+export const initReactI18next = { type: '3rdParty', init() {} };
+
+export default i18n;
