@@ -0,0 +1,81 @@
+import { ClashAPIConfig } from '~/types';
+
+import { buildWebSocketURL } from '../misc/request-helper';
+
+// podkop-exp build: a stream of the Clash API (/traffic, /memory, /connections) over a WebSocket
+// that is opened again whenever it ends. sing-box closes its streams when it restarts (an apply of
+// the settings of podkop), and a phone closes them or lets them die in the background; the page
+// then got no data until it was loaded again. Opened again after 1 s, then up to 10 s apart, and
+// at once when the page is shown again or the network comes back. Each of these streams brings a
+// message every second: one silent for STALE is taken for dead and replaced.
+
+const STALE = 10000;
+const FIRST_DELAY = 1000;
+const MAX_DELAY = 10000;
+
+export function openStream(
+  apiConfig: ClashAPIConfig,
+  endpoint: string,
+  onMessage: (data: string) => void,
+) {
+  let ws: WebSocket | null = null;
+  let timer = 0;
+  let delay = FIRST_DELAY;
+  let lastMessage = 0;
+
+  const connect = () => {
+    window.clearTimeout(timer);
+    timer = 0;
+    const mine = new WebSocket(buildWebSocketURL(apiConfig, endpoint));
+    ws = mine;
+    lastMessage = Date.now();
+    mine.addEventListener('open', () => {
+      delay = FIRST_DELAY;
+    });
+    mine.addEventListener('message', (event) => {
+      if (ws !== mine) return;
+      lastMessage = Date.now();
+      onMessage(event.data);
+    });
+    mine.addEventListener('close', () => {
+      if (ws !== mine) return;
+      ws = null;
+      timer = window.setTimeout(connect, delay);
+      delay = Math.min(delay * 2, MAX_DELAY);
+    });
+  };
+
+  // a socket that is open but brings nothing: let it go and open another
+  const replaceIfStale = () => {
+    if (ws && Date.now() - lastMessage > STALE) {
+      const stale = ws;
+      ws = null;
+      stale.close();
+      connect();
+    }
+  };
+
+  const wake = () => {
+    if (document.visibilityState !== 'visible') return;
+    if (!ws) {
+      delay = FIRST_DELAY;
+      connect();
+    } else {
+      replaceIfStale();
+    }
+  };
+
+  document.addEventListener('visibilitychange', wake);
+  window.addEventListener('online', wake);
+  window.setInterval(replaceIfStale, STALE / 2);
+  connect();
+}
+
+// the messages of a stream are JSON, one each; one that is not is skipped
+export function parseMessage<T>(data: string): T | null {
+  try {
+    return JSON.parse(data) as T;
+  } catch {
+    return null;
+  }
+}
