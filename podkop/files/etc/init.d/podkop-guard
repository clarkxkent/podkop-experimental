#!/bin/sh /etc/rc.common
# The guard of podkop's backend: what a backend that is down cannot do for itself (see
# /usr/libexec/podkop/guard). A service of its own, started before podkop: stopping podkop
# must not stop the guard in the middle of what it does.
# Off: uci set podkop.settings.guard=0; uci commit podkop; service podkop-guard restart
# (the liveness probe alone: podkop.settings.liveness=0)

USE_PROCD=1
START=95

start_service() {
	# The backend gives the router back when it stops. One that ended otherwise (power
	# lost, a panic) while its autostart was off is not started again to do that, and
	# dnsmasq would ask it for good: given back here, at boot. The command waits for a
	# backend that runs and then refuses, so one started by hand is left alone.
	if [ "$action" = boot ] && ! /etc/init.d/podkop enabled; then
		/usr/bin/podkop release >/dev/null 2>&1
	fi
	case "$(uci -q get podkop.settings.guard)" in
	0 | off | false | no | disabled) return 0 ;;
	esac
	procd_open_instance guard
	procd_set_param command /usr/libexec/podkop/guard
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}
